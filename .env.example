# Copy to .env and fill in. Never commit .env.
# Every service below is free tier or sponsor-provided.

# --- PayPal (SANDBOX only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account "Account ID" (merchant ID)
PAYPAL_MERCHANT_ID=
# Set after deploy by scripts/register-webhook.ts
PAYPAL_WEBHOOK_ID=
# Sandbox buyer (published in the README for judges; fake money)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# --- LLM providers (free tiers, via the Vercel AI SDK) ---
# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Model IDs (verified against each provider's model list at setup)
GEMINI_MAIN_MODEL=gemini-3.5-flash
GEMINI_PANEL_MODEL=gemini-flash-lite-latest
GROQ_PANEL_MODEL=openai/gpt-oss-120b
# Free-tier quotas copied from each provider's limits page (requests/min, tokens/min, requests/day)
GEMINI_PANEL_RPM=10
GEMINI_PANEL_TPM=250000
GEMINI_PANEL_RPD=500
GROQ_PANEL_RPM=30
GROQ_PANEL_TPM=8000
GROQ_PANEL_TPD=200000

# --- Channel3 (sponsor credits; promo code PAYPAL-HACKATHON-2026) ---
CHANNEL3_API_KEY=

# --- Database ---
# Neon free-tier pooled connection string. Leave empty to use local PGlite (no install needed).
DATABASE_URL=
PGLITE_DATA_DIR=./data/runtime/pglite

# --- App ---
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Bearer token that agents send to the Cart API (demo stand-in for PayPal's JWT)
STORE_API_TOKEN=change-me
# replay = serve recorded panels only (no LLM keys needed); live = allow live runs
DEMO_MODE=live
# Guards that keep the hosted demo inside free-tier quotas
LIVE_PANELS_PER_DAY=5
LIVE_BUYER_CHATS_PER_DAY=40
PANEL_SIZE=20
