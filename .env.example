# Copy to .env and fill in. Never commit .env.

# --- PayPal (SANDBOX only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account "Account ID" (merchant ID)
PAYPAL_MERCHANT_ID=
# Set after deploy by scripts/register-webhook.ts
PAYPAL_WEBHOOK_ID=
# Sandbox buyer (published in the README for judges; fake money)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# --- Anthropic ---
ANTHROPIC_API_KEY=
MAIN_MODEL=claude-opus-5-5
# Shopper-panel model (claude-opus-5-5 default; claude-haiku-5-5 is ~40x cheaper)
SHOPPER_MODEL=claude-opus-5-5

# --- Channel3 (promo code PAYPAL-HACKATHON-2026) ---
CHANNEL3_API_KEY=

# --- App ---
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Bearer token that agents send to the Cart API (demo stand-in for PayPal's JWT)
STORE_API_TOKEN=change-me
# Hard cap on live LLM spend per day for the hosted demo
LLM_DAILY_BUDGET_USD=3
# replay = serve recorded panels only (no LLM keys needed); live = allow live runs
DEMO_MODE=live
DATABASE_PATH=./data/runtime/chosenone.db
