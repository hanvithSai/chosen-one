{
  "name": "chosen-one",
  "version": "0.1.0",
  "private": true,
  "description": "When an AI shops for you, it picks one store. ChosenOne helps small PayPal merchants be that store.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "market:snapshot": "tsx scripts/market-snapshot.ts",
    "webhook:register": "tsx scripts/register-webhook.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.116",
    "@ai-sdk/groq": "^4.0.80",
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agentic-commerce-spec": "^1.1.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "ai": "^7.0.168",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "minisearch": "^7.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
